# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # SOLO en el servidor (Vercel env), nunca NEXT_PUBLIC

# Secreto compartido con n8n (header x-crm-secret). Generar con: openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Meta Graph API — usar token permanente de System User (no token de usuario de 60 días)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_TOKEN=

# Protección del cron de Vercel (Settings → Cron Jobs lo manda como Authorization: Bearer)
CRON_SECRET=

# URL pública de la app (para armar las ligas del portal de documentos)
NEXT_PUBLIC_APP_URL=http://localhost:3000
