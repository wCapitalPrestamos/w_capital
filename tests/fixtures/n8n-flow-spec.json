  "messageText": "={{ $json.messages[0].text?.body ?? \"\" }}",
  "messageId": "={{ $json.messages[0].id }}",
  "contactName": "={{ $json.contacts?.[0]?.profile?.name ?? null }}",
  "contactPhone": "={{ ($json.messages[0].from.startsWith('521') && $json.messages[0].from.length === 13) ? $json.messages[0].from.slice(0,2) + $json.messages[0].from.slice(3) : $json.messages[0].from }}",
  "messageType": "={{ $json.messages[0].type }}",
  "locationLat": "={{ $json.messages[0].location?.latitude ?? null }}",
  "locationLng": "={{ $json.messages[0].location?.longitude ?? null }}",
  "locationName": "={{ $json.messages[0].location?.name ?? $json.messages[0].location?.address ?? null }}",
  "mediaId": "={{ $json.messages[0][$json.messages[0].type]?.id ?? null }}",
  "mediaMimeType": "={{ $json.messages[0][$json.messages[0].type]?.mime_type ?? null }}",
  "buttonPayload": "={{ $json.messages[0].button?.payload ?? null }}",
  "interactiveButtonId": "={{ $json.messages[0].interactive?.button_reply?.id ?? $json.messages[0].interactive?.list_reply?.id ?? null }}"
 },
 "mg_fields": {
  "canal": "messenger",
  "senderId": "={{ $json.messaging[0].sender.id }}",
  "messageText": "={{ $json.messaging[0].message?.text ?? '' }}",
  "messageId": "={{ $json.messaging[0].message?.mid ?? $json.messaging[0].postback?.mid ?? null }}",
  "contactName": "={{ null }}",
  "messageType": "={{ ($json.messaging[0].postback || $json.messaging[0].message?.quick_reply) ? 'postback' : ($json.messaging[0].message?.attachments?.[0]?.type ? ($json.messaging[0].message.attachments[0].type === 'file' ? 'document' : ($json.messaging[0].message.attachments[0].type === 'fallback' ? 'sticker' : $json.messaging[0].message.attachments[0].type)) : 'text') }}",
  "locationLat": "={{ $json.messaging[0].message?.attachments?.[0]?.payload?.coordinates?.lat ?? null }}",
  "locationLng": "={{ $json.messaging[0].message?.attachments?.[0]?.payload?.coordinates?.long ?? null }}",
  "locationName": "={{ null }}",
  "mediaUrl": "={{ $json.messaging[0].message?.attachments?.[0]?.payload?.url ?? null }}",
  "mediaMimeType": "={{ $json.messaging[0].message?.attachments?.[0]?.type === 'image' ? 'image/jpeg' : ($json.messaging[0].message?.attachments?.[0]?.type === 'video' ? 'video/mp4' : ($json.messaging[0].message?.attachments?.[0]?.type === 'audio' ? 'audio/mp4' : ($json.messaging[0].message?.attachments?.[0]?.type === 'file' ? 'application/pdf' : null))) }}",
  "postbackPayload": "={{ $json.messaging[0].postback?.payload ?? $json.messaging[0].message?.quick_reply?.payload ?? null }}"
 },
